# Copy to .env.local and fill in. Never commit .env.local.

# Required for AI features. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the models (defaults shown). Image generation needs a paid tier.
# BAMIO_TEXT_MODEL=gemini-3.8-flash
# BAMIO_IMAGE_MODEL=gemini-3.1-flash-image
# BAMIO_VOICE_MODEL=gemini-3.8-flash-tts

# Optional: 1 = deterministic fake AI responses (demos and end-to-end tests, no key needed).
# BAMIO_AI_MOCK=1
