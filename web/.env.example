# Copy the values you need into web/.env (or .env.local). Never put real keys in this file:
# it is committed to git.

# On a server with compose.yaml (see DEPLOY.md): your domain, pointed at the server, and a long
# random password for the database (e.g. from `openssl rand -hex 24`).
# DOMAIN=bamio.example.com
# POSTGRES_PASSWORD=

# Clerk (written by `clerk init`): NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, sign-in/up URLs.

# AI: finding clips. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the models (defaults shown). "none" turns the fallback off.
# BAMIO_TEXT_MODEL=gemini-3.8-flash
# BAMIO_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: 1 = deterministic fake AI answers (demos and end-to-end tests, no key needed).
# BAMIO_AI_MOCK=1

# Optional: plans and payments with Stripe. Without a key nothing is limited. Use a test key
# (sk_test_...) first, then run `npm run stripe:setup`. Keys: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=
# Signing secret of the webhook to /api/billing/webhook (`stripe listen` prints one locally).
# STRIPE_WEBHOOK_SECRET=
# The site's address, for Stripe's return links (default: the address the request came to) and
# the links in emails (required for emails in production; default http://localhost:3000 in development).
# BAMIO_APP_URL=https://bamio.example.com
# Optional: off = plans off even with a Stripe key (local work, and the end-to-end test server).
# BAMIO_BILLING=off

# Optional: emails to users through Resend: plan started, changed, ending and ended, failed
# payments, videos ready or failed, AI minutes running low. Make a key at https://resend.com/api-keys,
# verify your domain at https://resend.com/domains, then: npm run email:check -- you@example.com
# RESEND_API_KEY=
# The sender, on the verified domain.
# EMAIL_FROM=Bamio <hello@your-domain.com>
# Optional: where replies go.
# EMAIL_REPLY_TO=support@your-domain.com
# Optional: off = no emails; preview = written and logged, never sent (the end-to-end test servers).
# BAMIO_EMAIL=preview

# Database (Postgres 16+): projects, transcripts, jobs, billing. Required in production.
# In development it defaults to the local one from `npm run db:local`
# (postgres://postgres@127.0.0.1:54329/bamio).
# DATABASE_URL=postgres://user:password@host:5432/bamio
# Optional: connections per process (default 10).
# DATABASE_POOL_SIZE=10

# Storage for videos, thumbnails and exports: local files (default) or S3-compatible
# (AWS S3, Cloudflare R2, MinIO). Setting S3_BUCKET switches to S3.
# STORAGE_DRIVER=s3
# S3_BUCKET=bamio
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: 1 for path-style addresses (MinIO).
# S3_FORCE_PATH_STYLE=1
# Optional: where browsers reach the store, when that differs from S3_ENDPOINT (Docker Compose).
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Workers: by default the web server also runs jobs (imports, exports, followed streams).
# off = it only queues them, for separate worker processes (`npm run build:worker`, `npm run worker`).
# BAMIO_WORKER=off
# Optional: jobs at once per worker process (defaults 2, 2, 4).
# BAMIO_IMPORT_SLOTS=2
# BAMIO_EXPORT_SLOTS=2
# BAMIO_STREAM_SLOTS=4
# Optional: scratch space for work in progress (downloads, renders). Default: web/.work
# BAMIO_WORK_DIR=

# Optional: where local storage keeps projects' media. Default: web/.data
# BAMIO_DATA_DIR=

# Optional: where the on-device speech models and caption fonts are kept (npm run setup:media). Default: web/.models
# BAMIO_MODELS_DIR=
# Optional: fast = smaller speech models (English 110M, other languages Omnilingual 300M): about twice as fast, less accurate.
# BAMIO_SPEECH_MODEL=accurate
# Optional: 0 = transcribe with Gemini instead of on the device (not recommended: timing is far less accurate).
# BAMIO_LOCAL_TRANSCRIBE=1
# Optional: how far back following a live stream may start, in seconds (default 21600 = 6 hours).
# BAMIO_FOLLOW_MAX_BACK_SEC=21600

# Optional: use your own media tools instead of the bundled ones.
# FFMPEG_PATH=
# FFPROBE_PATH=
# YTDLP_PATH=
