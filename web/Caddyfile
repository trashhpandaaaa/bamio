# HTTPS for Bamio (compose.yaml): Caddy gets and renews the certificate for DOMAIN from
# Let's Encrypt, once the domain's DNS points at this server.
{
	# A TLS connection that doesn't name the site (no SNI) still gets DOMAIN's certificate.
	# Without it the handshake fails, which Cloudflare reports as error 525 (Google Search
	# Console saw one reading the sitemap).
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	encode zstd gzip
	# While the app restarts (an update), requests wait for it, up to 30 s, instead of failing.
	reverse_proxy app:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Plain http to the https address (Caddy's own redirect names the port: https://DOMAIN:443/).
# Certificate challenges over http are still answered: Caddy handles them before any site.
http://{$DOMAIN}, http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# www.DOMAIN (when its DNS points here) goes to the one canonical address, keeping the path.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
